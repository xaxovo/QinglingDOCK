<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>QinglingDock.App</RootNamespace>
    <AssemblyName>QinglingDock</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>Application.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\QinglingDock.Core\QinglingDock.Core.csproj" />
    <ProjectReference Include="..\QinglingDock.Interop\QinglingDock.Interop.csproj" />
    <ProjectReference Include="..\QinglingDock.Rendering\QinglingDock.Rendering.csproj" />
  </ItemGroup>

</Project>
